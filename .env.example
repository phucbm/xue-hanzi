# URL of the service worker (generated by serwist at build time)
NEXT_PUBLIC_SW_URL=/sw.js

NEXT_PUBLIC_COUNTERAPI_KEY=your_api_key_here

# Discord webhook for issue reports
NEXT_PUBLIC_DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# OpenRouter — AI word explanation (server-side)
# Get your key: https://openrouter.ai/keys
# Available models: https://openrouter.ai/models?q=:free
OPENROUTER_API_KEY=
# Optional: override the default free model (see src/lib/aiModels.ts)
# AI_MODEL=openai/gpt-oss-120b:free

# Langfuse — AI observability (optional)
# Get your keys: https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Turso — Cloud database (syncs viewed word history for signed-in users)
# Get your database URL and token: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# History sync — single-user passphrase (server-side only)
HISTORY_PASSPHRASE=